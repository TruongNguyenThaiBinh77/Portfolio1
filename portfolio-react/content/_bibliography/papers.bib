@article{binh2026quanlynhanuoc,
  title           = {Quản lý nhà nước đối với nguồn lực văn hóa phục vụ phát triển du lịch bền vững ở một số nước châu Á: Kinh nghiệm cho tỉnh Tây Ninh},
  title_en        = {State management of cultural resources for sustainable tourism development in selected Asian countries: lessons for Tay Ninh province},
  author          = {Trương Nguyễn Thái Bình},
  author_en       = {Truong Nguyen Thai Binh},
  year            = {2026},
  month           = {10},
  journal         = {Tạp chí Quản lý nhà nước},
  journal_en      = {State Management Review},
  journal_bg_color = {#fef3c7},
  journal_color   = {#92400e},
  journal_border_color = {#fcd34d},
  url             = {https://www.quanlynhanuoc.vn/2026/10/12/quan-ly-nha-nuoc-doi-voi-nguon-luc-van-hoa-phuc-vu-phat-trien-du-lich-ben-vung-o-mot-so-nuoc-chau-a-kinh-nghiem-cho-tinh-tay-ninh/},
  pdf             = {/assets/pdf/quan-ly-nha-nuoc-tay-ninh.pdf},
  preview         = {TCQLNC.jpg},
  badge_name      = {TẠP CHÍ},
  badge_name_en   = {JOURNAL},
  badge_color     = {#b91c1c},
  badge_text_color = {#ffffff},
  abstract        = {Phát triển du lịch bền vững gắn với bảo tồn và phát huy giá trị văn hóa đặt ra yêu cầu hoàn thiện quản lý nhà nước đối với nguồn lực văn hóa, bảo đảm khai thác hiệu quả gắn với gìn giữ các giá trị văn hóa. Trên cơ sở phân tích kinh nghiệm của một số nước, như: Nhật Bản, Singapore, Hàn Quốc và Malaysia, bài viết khái quát một số mô hình thể chế, công cụ chính sách và cơ chế phối hợp giữa Nhà nước, cộng đồng, doanh nghiệp và các bên liên quan. Từ đó, rút ra một số kinh nghiệm cho tỉnh Tây Ninh nhằm hoàn thiện quản lý nhà nước đối với nguồn lực văn hóa, hướng đến phát triển du lịch bền vững.},
  abstract_en     = {Sustainable tourism development associated with the preservation and promotion of cultural values requires improvements in state management of cultural resources to ensure their effective utilization while safeguarding cultural values. Based on an analysis of experiences from selected countries, including Japan, Singapore, the Republic of Korea, and Malaysia, the article examines institutional models, policy instruments, and coordination mechanisms among the State, communities, businesses, and other stakeholders. It then draws several lessons for Tay Ninh Province to improve state management of cultural resources and promote sustainable tourism development.}
}

@article{binh2026congnghiepvanhoa,
  title           = {Phát triển công nghiệp văn hóa gắn với dịch vụ du lịch ở tỉnh Tây Ninh},
  title_en        = {Development of cultural industries associated with tourism services Tay Ninh province},
  author          = {Trương Nguyễn Thái Bình},
  author_en       = {Truong Nguyen Thai Binh},
  year            = {2026},
  month           = {10},
  journal         = {Tạp chí Thanh niên - Nghiên cứu khoa học},
  journal_en      = {Journal of Youth - Scientific Research},
  journal_bg_color = {#e0f2fe},
  journal_color   = {#0369a1},
  journal_border_color = {#7dd3fc},
  volume          = {113},
  pages           = {71--73},
  url             = {https://drive.google.com/file/d/1BBw0j1vdRZHRFXnwFqlWVrHdI9TItxnU/view?usp=sharing},
  pdf             = {/assets/pdf/phat-trien-cong-nghiep-van-hoa-tay-ninh.pdf},
  preview         = {TCTN.jpg},
  badge_name      = {TẠP CHÍ},
  badge_name_en   = {JOURNAL},
  badge_color     = {#1e3a8a},
  badge_text_color = {#ffffff},
  abstract        = {Bài viết phân tích tiềm năng, thực trạng và giải pháp phát triển công nghiệp văn hóa gắn với du lịch Tây Ninh. Dựa trên di sản, lễ hội, làng nghề, không gian tâm linh và sinh thái, địa phương đã hình thành nhiều sản phẩm văn hóa, du lịch và ứng dụng số. Tuy nhiên, quá trình phát triển còn hạn chế về thể chế, phối hợp liên ngành, nhân lực, hạ tầng sáng tạo, liên kết chuỗi giá trị và bảo hộ sở hữu trí tuệ. Bài viết đề xuất hoàn thiện chính sách, huy động nguồn lực, chuyển đổi số, phát triển hệ sinh thái sáng tạo và liên kết văn hóa - du lịch bền vững.},
  abstract_en     = {The article analyzes the potential, current situation and solutions for the development of the cultural industry associated with Tay Ninh tourism. Based on heritage, festivals, craft villages, spiritual and ecological spaces, the locality has formed many cultural products, tourism and digital applications. However, the development process is still limited in terms of institutions, interdisciplinary coordination, human resources, creative infrastructure, value chain linkages and intellectual property protection. The article proposes to improve policies, mobilize resources, transform digitally, develop a creative ecosystem and link culture - sustainable tourism.}
}

